# Copy to `.env` and fill in to enable the real Spotify OAuth flow.
# Without this, Spotify falls back to the simulated demo flow.
#
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add the redirect URI that the app logs on launch (scheme: driveflow),
#    e.g. driveflow://  (and the Expo Go proxy URI during development)
# 3. Paste the app's Client ID below. PKCE is used, so no client secret is needed.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
